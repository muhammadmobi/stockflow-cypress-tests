{
  "apis": {
    "tableItems": "/reports/inventory-value-report?*",
    "groupedTableItems": "/reports/inventory-value-report/grouped?*",
    "columnConfig": "/configs*inventoryValueReportCustomizeColumn*",
    "poList": "/excel/po-numbers*"
  },
  "aliases": {
    "tableItems": "costReportTableItemsApi",
    "groupedTableItems": "costReportGroupedTableItemsApi",
    "columnConfig": "costReportColumnConfigApi",
    "poList": "costReportPoListApi"
  },
  "pagination": {
    "defaultPage": 1,
    "defaultPageSize": 25,
    "pageSizeOptions": [25, 50, 75, 100, 150]
  },
  "filters": {
    "defaultDatePreset": "Today",
    "defaultPo": "All POs",
    "statuses": [
      { "label": "Default (Available)", "value": "default" },
      { "label": "Damaged",             "value": "Damaged" },
      { "label": "Disputed",            "value": "Disputed" },
      { "label": "Missing",             "value": "Missing" },
      { "label": "Sold",                "value": "Sold" },
      { "label": "Stocked Out",         "value": "StockedOut" }
    ],
    "defaultStatus": "default"
  },
  "statCard": {
    "title": "Total Inventory Cost"
  }
}
